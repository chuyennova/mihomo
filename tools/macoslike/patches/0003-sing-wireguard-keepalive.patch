+	// Preserve the historical sing-wireguard 15-second keepalive only for
+	// ordinary stacks. A normal macOS socket does not have SO_KEEPALIVE forced
+	// on for every outbound connection, so the macOS-like profile leaves it off
+	// unless the application explicitly requests it.
+	if !s.MacOSLike() {
+		ep.SocketOptions().SetKeepAlive(true)
+		keepAliveIdle := tcpip.KeepaliveIdleOption(15 * time.Second)
+		ep.SetSockOpt(&keepAliveIdle)
+		keepAliveInterval := tcpip.KeepaliveIntervalOption(15 * time.Second)
+		ep.SetSockOpt(&keepAliveInterval)
